# Copy to `.env` and edit. Chat settings (except the server URL) also prefill
# the UI form and can be changed at runtime.

# The real XiansAi server. Vite proxies `/api/*` to this target so the browser
# only makes same-origin requests (no CORS needed). NOTE: on macOS, port 5000 is
# taken by AirPlay Receiver, so the server typically runs on 5005.
VITE_SERVER_URL=http://localhost:5005
VITE_TENANT_ID=default

# Participant ID is taken from the signed-in OIDC user (email, else sub) — not set here.

# The workflow accepts two formats (see api-key-chat README):
#   1. Workflow TYPE  -> "Agent Name:Flow Name"   (0-1 colon, resolved against your tenant)
#   2. Fully-qualified workflow ID -> "<tenant>:Agent Name:Flow Name[:Run Suffix]"
# If the value has 2+ colons it MUST start with your tenant id. Do not quote it.
VITE_WORKFLOW=default:Echo Agent:Supervisor Workflow:Echo Agent - Ugly Pelican

# --- OIDC (generic; Google example values below) ---
# Authority / issuer URL for your IdP.
# Google: https://accounts.google.com
VITE_OIDC_AUTHORITY=https://accounts.google.com

# Client id from your IdP console.
VITE_OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google "Web application" OAuth clients require this at the token exchange
# (even with PKCE). Leave empty for true public SPA IdPs (Auth0, Keycloak SPA).
# WARNING: VITE_ vars are bundled into the browser — local demo only; do not
# ship a real Google client secret in a production frontend.
VITE_OIDC_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Must match an authorized redirect URI on the IdP and this Vite app's port (3000).
# Azure SPA: prefer the app origin (http://localhost:3000) or /callback — not
# /callback.html unless that exact path is registered. Use localhost, not 127.0.0.1.
VITE_OIDC_REDIRECT_URI=http://localhost:3000
# Optional dedicated silent-renew page. Leave unset to renew via refresh_token
# when the scope includes offline_access.
# VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:3000/silent-renew.html
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Space-separated scopes. Google typically: openid profile email
VITE_OIDC_SCOPE=openid profile email

# Which token to send as Authorization Bearer to UserApi.
# - access_token (default): use when your IdP issues JWT access tokens (Auth0, Keycloak, …)
# - id_token: use for Google (Google access tokens are usually opaque, not JWTs)
VITE_OIDC_TOKEN_TYPE=id_token

# Optional. Some IdPs need an audience / resource (passed as extraQueryParams.audience).
# Leave empty for Google.
# VITE_OIDC_AUDIENCE=
